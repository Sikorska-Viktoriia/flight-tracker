# Choose exactly one queue/cache stack:
# standalone = RabbitMQ + Redis
# postgres_native = PostgreSQL queue/cache tables; no extensions or external services
# postgres_extensions = PostgreSQL + pgmq + pg_cron
POSTGRES_DB=flightdb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
APP_DB_USER=flightapp
APP_DB_PASSWORD=
DATABASE_URL=

# Fetcher URL and polling cadence.
RABBITMQ_USER=flightapp
RABBITMQ_PASSWORD=
AMQP_URL=
REDIS_PASSWORD=
REDIS_URL=
STORAGE_BACKEND=standalone
POLL_INTERVAL_SEC=300
FETCHER_TIMEOUT_SEC=30
SESSION_TTL_SEC=2592000

# Local development ports; Vagrant UI also gets an address from the LAN router.
PORT=8000
FETCHER_PORT=8081

# ADS-B.lol coverage centered on Central Europe, within 250 nautical miles.
FLIGHT_API_URL=https://api.adsb.lol/v2/lat/51.75/lon/19/dist/250
FLIGHT_API_CACHE_SEC=300
